# Variables de docker-compose (copiar a .env, que no se versiona). Valores: docs/Desarrollo_Local.md
# Las contraseñas de los roles se aplican solo en el primer arranque del volumen de Postgres;
# para cambiarlas: docker compose down -v (borra los datos) y volver a levantar.
POSTGRES_PORT=
POSTGRES_SUPERUSER_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
VALKEY_PORT=
