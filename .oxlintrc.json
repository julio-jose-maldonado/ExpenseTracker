{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "jest",
    "vitest",
    "react",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/generated/**",
    "**/coverage/**"
  ],
  "rules": {
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": [
          "reflect-metadata",
          "**/*.css",
          "@testing-library/jest-dom/vitest",
          "**/i18n/i18n"
        ]
      }
    ],
    "react/react-in-jsx-scope": "off"
  }
}
