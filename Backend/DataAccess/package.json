{
  "name": "@expense-tracker/data-access",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@expense-tracker/core": "workspace:*",
    "@expense-tracker/proto": "workspace:*",
    "@grpc/grpc-js": "1.14.7",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "tsyringe": "4.10.0"
  },
  "devDependencies": {
    "@expense-tracker/testing": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
