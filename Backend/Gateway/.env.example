# Copiar a .env (no se versiona). Valores: docs/Desarrollo_Local.md
PORT=
BUSINESS_GRPC_ADDRESS=
# Valkey del Gateway (rate limit; después, sesiones). redis:// en local, rediss:// (TLS) en AWS.
VALKEY_URL=
# Opcional. Proxies propios delante del Gateway; vacío = 0 (local).
TRUSTED_PROXY_HOPS=
# Opcional. Máximo del límite general de requests; vacío = el de la tabla (Shared/RateLimit/RateLimits.ts).
RATE_LIMIT_GENERAL_MAX=
